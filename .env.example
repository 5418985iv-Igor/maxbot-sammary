# BASE_PATH: Base path for subpath deployment (e.g. /max for https://vivonline.ru/max)
# Leave empty or set to "" for subdomain/root deployment (e.g. http://max.vivonline.ru)
BASE_PATH=/max
NEXT_PUBLIC_BASE_PATH=/max

# MAX Bot API token (obtain from https://dev.max.ru or MAX bot management)
MAX_BOT_TOKEN=

# MAX Webhook configuration
# Production Webhook URL:
MAX_WEBHOOK_URL=https://vivonline.ru/max/webhook/max

# MAX Webhook secret (for validating X-Max-Bot-Api-Secret header on /max/webhook/max)
MAX_WEBHOOK_SECRET=

# OPENAI_API_KEY: Required for OpenAI chat summaries
OPENAI_API_KEY=

# Disable TLS certificate validation for Russian Trusted Root CA (platform-api2.max.ru)
NODE_TLS_REJECT_UNAUTHORIZED=0

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
