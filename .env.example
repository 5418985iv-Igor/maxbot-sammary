# MAX Bot API token (obtain from https://dev.max.ru or MAX bot management)
MAX_BOT_TOKEN=

# MAX_WEBHOOK_SECRET: Secret for X-Max-Bot-Api-Secret header verification
MAX_WEBHOOK_SECRET=

# OPENAI_API_KEY: Required for OpenAI chat summaries
OPENAI_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
